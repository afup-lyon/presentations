<section class="calendrier" data-background-image="img/fond-hexagones.png">
    <div class="canevas">
        <img class="lion" src="img/logos/antenne-only-icon.svg" alt=""/>

        <h1 class="titre">Save the<br/>date !</h1>

        <div class="cartes" style="--nombre: {{ config.calendrierAntenne|length }};">
            {% for event in config.calendrierAntenne %}
                <div class="hexagone">
                    <p class="titre-carte">
                        {%- if event.estTexteLibre -%}
                            {{ event.date }}
                        {%- else -%}
                            {{ event.date|format_date(locale='fr', pattern='EEEE d MMMM') }}
                        {%- endif -%}
                    </p>
                    <p class="texte-espace">{{ event.title }}</p>
                    {% if event.logo %}
                        <img class="logo" src="img/calendrier/{{ event.logo }}" alt=""/>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>
</section>
