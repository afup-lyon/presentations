<section class="afup-day" data-background-image="img/fond-hexagones.png">
    <div class="canevas">
        {% if config.afupDayInclurePhotosEditionPrecedente %}
            <img class="photo-arrondie photo-1" src="img/afup-day/top-left.jpg" alt=""/>
            <img class="photo-arrondie photo-2" src="img/afup-day/top-right.jpg" alt=""/>
            <img class="photo-arrondie photo-3" src="img/afup-day/bottom-left.jpg" alt=""/>
            <img class="photo-arrondie photo-4" src="img/afup-day/bottom-right.jpg" alt=""/>
            <p class="texte-espace legende">L'AFUP Day en {{ config.afupDayInclurePhotosEditionPrecedente }}</p>
        {% else %}
            <img class="grand-logo" src="img/logos/afup-day.svg" alt=""/>
        {% endif %}

        <div class="infos">
            <img class="logo" src="img/logos/afup-day.svg" alt="AFUP Day"/>

            {% if config.afupDayDate %}
                <p class="texte-espace">{{ config.afupDayDate|format_date(locale='fr', pattern='EEEE d MMMM y') }}</p>
            {% endif %}

            {% if config.afupDayVilles is not empty %}
                <p class="texte-espace">{{ config.afupDayVilles|join(', ') }}</p>
            {% endif %}

            <p class="texte-espace">CFP ouvert</p>

            {% if config.afupDayDateProgrammeDisponible %}
                <p class="texte-espace">
                    Programme dispo
                    {% if config.afupDayDateProgrammeDisponible < date() %}depuis{% endif %}
                    le {{ config.afupDayDateProgrammeDisponible|format_date(locale='fr', pattern='d MMMM') }}
                </p>
            {% endif %}

            <p class="texte-espace">event.afup.org</p>

            {% if config.afupDayInclureQRCodeCFP %}
                <img class="qr" src="img/qr/cfp.png" alt="QR code vers le CFP de l'AFUP Day"/>
            {% endif %}
        </div>
    </div>
</section>
