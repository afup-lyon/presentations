<section class="association" data-background-image="img/fond-hexagones.png">
    <div class="canevas">
        <div class="entete">
            <img src="img/logos/afup.png" alt="AFUP"/>
            <p class="nom">Association Française des<br/>Utilisateur·rices de PHP</p>
        </div>

        <div class="cartes">
            <div class="hexagone">
                <img class="icone" src="img/icones/promouvoir.png" alt=""/>
                <p class="titre-carte">Promouvoir le langage</p>
                <p>et son écosystème</p>
            </div>

            <div class="hexagone">
                <img class="icone" src="img/icones/contribuer.png" alt=""/>
